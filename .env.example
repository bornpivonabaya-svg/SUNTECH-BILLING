# --- Core ---
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgresql://mashupkgrid:mashupkgrid@localhost:5432/mashupkgrid_isp?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth secrets (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_PEPPER=
ENCRYPTION_KEY=

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
# Must be internet-reachable for Safaricom to deliver M-Pesa callbacks (e.g. an ngrok tunnel in dev)
APP_API_PUBLIC_URL=http://localhost:4000

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
APP_WEB_URL=http://localhost:3000

# --- Worker ---
WORKER_CONCURRENCY=5

# "Sign in with Google" is configured from the dashboard (super admin > Google Sign-In), not an
# env var — see PlatformGoogleAuthConfig in the schema.

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mashupkgrid.local

# --- Resend Email API (resend.com) ---
RESEND_API_KEY=
RESEND_FROM="MASHUPKGRID ISP <onboarding@resend.dev>"

# --- Push alerts to staff devices (router down, large payment) ---
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@mashuphost.tech

# --- M-Pesa ---
# Real credentials are configured per-tenant (encrypted) via the admin UI/API, not here.
# These are only used as the seed script's optional default for the local demo tenant.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# --- SMS / WhatsApp (Phase 5 — not used in Phase 1) ---
SMS_API_KEY=
WHATSAPP_API_KEY=
# Self-hosted WhatsApp (packages/whatsapp, via Baileys) — pairs with a real WhatsApp number by
# QR code, no Meta Business API needed. See packages/whatsapp/src/connect.ts to pair.
ENABLE_WHATSAPP_BOT=false
WHATSAPP_AUTH_STATE_PATH=./.whatsapp-auth
# Optional: your own number in E.164 (+2547XXXXXXXX) — connect.ts sends a one-time test message
# here once paired, to confirm sending works.
WHATSAPP_TEST_RECIPIENT=

# --- File storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# --- Payment gateway (development only) ---
# When "true" (and NODE_ENV is not production), tenant settlements are simulated instead of being
# sent to M-Pesa B2B/B2C; a super admin supplies the provider's result from the Settlements screen.
# Ignored in production.
PAYMENTS_SANDBOX_SETTLEMENTS=false

# --- Routers ---
# Where routers send RADIUS and which address may manage them. Set RADIUS_SERVER_HOST to THIS
# server's public IPv4 address on every real deployment (RouterOS needs an IP, and a domain behind
# Cloudflare resolves to Cloudflare, which does not carry RADIUS). Left empty, the platform uses the
# API host from APP_API_PUBLIC_URL / ROUTER_API_BASE_URL, resolved to an IP.
# To test a physical router on the SAME LAN as this machine, set all three to this machine's LAN
# address, e.g. 192.168.1.183, and ENABLE_EMBEDDED_RADIUS_SERVER=true.
RADIUS_SERVER_HOST=
ROUTER_MANAGEMENT_SOURCE=
ROUTER_API_BASE_URL=
# Remote WinBox relay (production only; needs the WireGuard interface).
ENABLE_WINBOX_RELAY=false
WINBOX_RELAY_PORT_RANGE=20000-20199
WINBOX_RELAY_PUBLIC_HOST=
WINBOX_RELAY_ALLOWED_SOURCES=

# Sanity CMS for the homepage (optional). Leave SANITY_PROJECT_ID empty to keep using the
# built-in Landing editor. The Studio lives in /studio — see studio/README.md.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Only for a private dataset; a public dataset needs no token.
SANITY_READ_TOKEN=
# Secret for the Sanity webhook to https://<your site>/cms/revalidate (instant updates on publish).
SANITY_REVALIDATE_SECRET=
