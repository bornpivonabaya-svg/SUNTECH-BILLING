# One-off hardware-debugging scratch scripts (packages/database/*.cjs) — these hardcode real
# secrets copied from .env for convenience during live router testing (encryption key, RADIUS
# shared secret, router credentials). .env itself is gitignored above; these scripts weren't,
# which would otherwise let a routine `git add -A` commit those same secrets to history via a
# different file. Not deleted outright since they're still useful hands-on debugging tools.
packages/database/*.cjs

# WhatsApp (Baileys) paired-session auth keys — effectively equivalent to a login session for a
# real phone number, must never be committed.
.whatsapp-auth/

# Production secrets live only on the server.
.env.production

# Per-machine Claude Code settings.
.claude/settings.local.json

# One-off hardware-provisioning scratch scripts. Same category as packages/database/*.cjs
# above: they hardcode router addresses and RADIUS shared secrets typed in by hand during live
# MikroTik testing, so a routine `git add -A` publishes credentials.
scratch/

# Captive-portal configs are runtime state each deployment owns (they hold a tenant's live
# support phone number), written by the API at apps/api/data/captive-portal/<slug>.json and
# persisted by the `captive_portal_data` volume in docker-compose.prod.yml. Committing them
# meant a deploy silently restored a developer's copy over whatever the ISP had saved.
apps/api/data/

# Vitest temp bundles
*.timestamp-*.mjs
