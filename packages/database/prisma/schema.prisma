// MASHUPKGRID ISP — Phase 1 (Foundation) + Phase 2 (Core ISP Billing) schema.
// See docs/architecture/01-database-erd-and-schema.md for Phase 1's design rationale and
// docs/architecture/04-billing-and-payments.md + 09-phase2-plan.md for Phase 2's.
// Later phases (Router, RadiusUser, Ticket, Lead, Installation, ...) extend this file further.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  PENDING_APPROVAL
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  LOCKED
  PENDING_VERIFICATION
}

model Tenant {
  id                     String                  @id @default(uuid())
  servicePauses          ServicePause[]
  routerBackups          RouterBackup[]
  routerRollouts         RouterRollout[]
  jobCards               JobCard[]
  referralRewards        ReferralReward[]
  networkMaintenance     NetworkMaintenance[]
  upgradeSuggestions     UpgradeSuggestion[]
  name                   String
  slug                   String                  @unique
  status                 TenantStatus            @default(ACTIVE)
  planTier               String                  @default("standard")
  timezone               String                  @default("Africa/Nairobi")
  currency               String                  @default("KES")
  /// White-label branding — a single hex color (e.g. "#2563eb"), expanded into a full Tailwind
  /// shade scale client-side (apps/web/src/lib/color-scale.ts) rather than storing 11 values.
  brandColor             String?
  logoUrl                String?
  /// Set once, at tenant creation (now() + 7 days) — never extended automatically. Null means
  /// "not on a trial" (e.g. a tenant created before this existed, or one a super admin marked
  /// as paid/exempt). See apps/worker's expire-trials job for what actually happens when this
  /// passes, and apps/api's login flow for the countdown a tenant's own staff see.
  trialEndsAt            DateTime?
  /// A fixed catalog of feature keys (see packages/shared/src/features.ts) a super admin has
  /// turned OFF for this specific tenant — empty means every feature is available. Deliberately
  /// a disable-list, not an enable-list: a newly added feature is available to every existing
  /// tenant by default instead of silently missing until someone remembers to grant it.
  ledgerEntries          TenantLedgerEntry[]
  payouts                TenantPayout[]
  disabledFeatures       String[]                @default([])
  /// Where this tenant's customer payments land.
  ///
  /// OWN (the default, and what every existing tenant keeps) means the tenant's own M-Pesa
  /// credentials collect directly and the money never touches this platform — nothing to remit.
  /// PLATFORM means the platform's paybill collects on their behalf and owes them the balance,
  /// which is what the ledger and payouts below settle. Making this explicit per tenant is what
  /// stops the aggregator model silently changing where an existing tenant's money goes.
  collectionMode         TenantCollectionMode    @default(OWN)
  /// Where a payout is sent. Not credentials — this platform pushes money TO this number, so it
  /// needs no secret from the tenant, only the destination.
  payoutShortcode        String?
  /// "PAYBILL" | "TILL" — selects the Daraja B2B command (BusinessPayBill vs BusinessBuyGoods).
  payoutShortcodeType    String                  @default("PAYBILL")
  /// Payment methods this tenant has switched OFF for their captive portal, e.g. ["PAYSTACK"].
  ///
  /// A disable-list rather than an enable-list, matching disabledFeatures above and for the same
  /// reason: a method that becomes available to a tenant (they configure a gateway, or they are
  /// switched to platform collection) should appear on their portal without anyone remembering
  /// to opt them in. Turning one off is the deliberate act, so that is what gets recorded.
  /// Per-tenant fee override; null falls back to PlatformSettlementSettings.
  feePercentBpsOverride  Int?
  feeFixedMinorOverride  Int?
  settlementDestinations SettlementDestination[]
  gatewayTransactions    GatewayTransaction[]
  paymentReferences      PaymentReference[]
  gatewayRefunds         GatewayRefund[]
  paymentWebhookEvents   PaymentWebhookEvent[]
  portalPaymentsDisabled String[]                @default([])
  /// Operational preferences the ISP sets for itself: payment reminder schedule and message
  /// templates, ticket response targets. Shape and defaults in packages/shared preferences.ts.
  preferences            Json                    @default("{}")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?

  users            User[]
  branches         Branch[]
  roles            Role[]
  userRoles        UserRole[]
  sessions         Session[]
  auditLogs        AuditLog[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]

  customers        Customer[]
  packages         Package[]
  customerServices CustomerService[]
  invoices         Invoice[]
  payments         Payment[]
  receipts         Receipt[]

  paymentProviderConfigs PaymentProviderConfig[]
  mpesaStkRequests       MpesaStkRequest[]
  mpesaC2BTransactions   MpesaC2BTransaction[]
  paystackTransactions   PaystackTransaction[]
  smsProviderConfig      SmsProviderConfig?
  aiAssistantConfig      AiAssistantConfig?
  liveChatConfig         LiveChatConfig?
  captivePortalConfig    CaptivePortalConfig?
  vlans                  Vlan[]
  whatsappConnection     WhatsappConnection?
  tickets                Ticket[]
  onboardingFee          TenantOnboardingFee?
  announcements          PlatformAnnouncement[]
  domains                Domain[]
  subscription           TenantSubscription?
  subscriptionPayments   TenantSubscriptionPayment[]

  routers          Router[]
  ipPools          IPPool[]
  ipAddresses      IPAddress[]
  radiusNas        RadiusNas[]
  radiusUsers      RadiusUser[]
  radAccts         RadAcct[]
  hotspotPackages  HotspotPackage[]
  hotspotVouchers  HotspotVoucher[]
  networkSyncTasks NetworkSyncTask[]
  provisioningJobs ProvisioningJob[]
  customerMembers  CustomerMember[]
  addOns           AddOn[]
  addOnPurchases   AddOnPurchase[]
  winBackOffers    WinBackOffer[]
  agents           Agent[]
  agentSales       AgentSale[]
  agentRemittances AgentRemittance[]
  campaigns        Campaign[]
  leads            Lead[]
  supportChats     SupportChat[]

  @@index([status])
  @@map("tenants")
}

model User {
  id                  String     @id @default(uuid())
  assignedJobs        JobCard[]  @relation("JobCardAssignee")
  tenantId            String?
  tenant              Tenant?    @relation(fields: [tenantId], references: [id])
  /// Staff member's home branch: the branch their lists open on. Null means all branches.
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// The person's name as they gave it (ISP sign-up, staff invite). Optional: older accounts
  /// have none, and the email stands in for it.
  name                String?
  email               String
  phone               String?
  passwordHash        String
  /// Two-step login: null when off. TOTP uses an authenticator app (secret in
  /// totpSecretEncrypted); SMS sends a code to `phone`. totpEnabledAt is when it was turned on.
  mfaMethod           MfaMethod?
  /// SHA-256 hashes of the unused one-time recovery codes.
  mfaRecoveryCodes    String[]   @default([])
  emailVerifiedAt     DateTime?
  status              UserStatus @default(PENDING_VERIFICATION)
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  /// The authenticator secret, encrypted at rest. Set while setting up, before mfaMethod is.
  totpSecretEncrypted String?
  totpEnabledAt       DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  sessions                Session[]
  pushSubscriptions       PushSubscription[]
  userRoles               UserRole[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  loginAttempts           LoginAttempt[]
  auditLogsAsActor        AuditLog[]               @relation("AuditLogActor")
  customerProfile         Customer?
  customerMembership      CustomerMember?
  apiKeysCreated          ApiKey[]
  ticketsAssigned         Ticket[]                 @relation("TicketAssignee")
  ticketsCreated          Ticket[]                 @relation("TicketCreatedBy")
  ticketMessages          TicketMessage[]
  agentProfile            Agent?

  // Composite-unique keeps email unique within a tenant. Super-admin rows (tenantId = null)
  // additionally get a partial unique index on `email` alone via raw SQL migration, since
  // Postgres treats NULL != NULL and would otherwise allow duplicate super-admin emails.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  tenantId  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // tenantId = null represents a platform-level (SUPER_ADMIN) role assignment.
  @@unique([userId, roleId, tenantId])
  @@index([tenantId, userId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId         String?
  tenant           Tenant?   @relation(fields: [tenantId], references: [id])
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  lastUsedAt       DateTime  @default(now())

  // Refresh-token rotation chain: each successful refresh revokes this row and creates a new
  // one pointing back here via previousSessionId. A replay of an already-rotated (revoked)
  // refresh token is detected because its hash still resolves to a *revoked* row — that is
  // treated as stolen-token reuse and revokes every session the user holds.
  previousSessionId String?  @unique
  previousSession   Session? @relation("SessionRotation", fields: [previousSessionId], references: [id])
  nextSession       Session? @relation("SessionRotation")

  @@index([userId])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model LoginAttempt {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  email         String
  tenantId      String?
  ipAddress     String
  userAgent     String?
  success       Boolean
  failureReason String?
  createdAt     DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  actorUserId  String?
  actor        User?    @relation("AuditLogActor", fields: [actorUserId], references: [id])
  action       String
  resourceType String
  resourceId   String?
  before       Json?
  after        Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

/// Every maintenance state change is a new row — the latest row by createdAt is the
/// authoritative current state. This makes the audit trail free (see docs/architecture/05).
model MaintenanceEvent {
  id                  String    @id @default(uuid())
  enabled             Boolean
  level               Int
  message             String?
  startAt             DateTime?
  endAt               DateTime?
  allowLogin          Boolean   @default(true)
  allowCustomerPortal Boolean   @default(true)
  allowPayments       Boolean   @default(true)
  allowWebhooks       Boolean   @default(true)
  allowApi            Boolean   @default(true)
  allowedRoles        String[]
  allowedIps          String[]
  updatedBy           String
  createdAt           DateTime  @default(now())

  @@index([createdAt])
  @@map("maintenance_events")
}

model ApiKey {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  keyPrefix          String
  keyHash            String    @unique
  scopes             String[]
  rateLimitPerMinute Int       @default(100)
  /// The staff user whose current role/permissions this key acts as at request time (looked up
  /// fresh on every use, same as a session — revoking the user's role revokes the key too,
  /// without a separate expiry mechanism). Nullable only so a user's later deletion doesn't
  /// cascade-delete keys they issued; such an orphaned key can no longer authenticate.
  createdByUserId    String?
  createdBy          User?     @relation(fields: [createdByUserId], references: [id])
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  @@index([tenantId])
  @@map("api_keys")
}

/// An outbound webhook subscription — real platform events (customer created, invoice
/// created, payment received) are signed with `secretEncrypted` (HMAC-SHA256, same scheme as
/// Paystack's inbound webhooks but for our own outbound deliveries) and POSTed to `url` by the
/// worker's webhook queue, never inline in the request that triggered the event.
model WebhookEndpoint {
  id                  String    @id @default(uuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url                 String
  description         String?
  secretEncrypted     String
  events              String[]
  isActive            Boolean   @default(true)
  createdByUserId     String?
  lastTriggeredAt     DateTime?
  lastStatusCode      Int?
  consecutiveFailures Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id                String          @id @default(uuid())
  webhookEndpointId String
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  eventType         String
  payload           Json
  statusCode        Int?
  success           Boolean
  errorMessage      String?
  attemptedAt       DateTime        @default(now())

  @@index([webhookEndpointId, attemptedAt])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------------------------
// Phase 2 — Core ISP Billing (docs/architecture/04-billing-and-payments.md, 09-phase2-plan.md)
// ---------------------------------------------------------------------------------------------

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  PENDING
  INSTALLATION
  DISCONNECTED
  CANCELLED
  BLACKLISTED
}

model Customer {
  id                    String              @id @default(uuid())
  /// Secret on the printed install card: scanning its QR lets the customer set up their own
  /// app login and see how to connect their router. Expires; replaced when a new card is printed.
  installCode           String?             @unique
  installCodeExpiresAt  DateTime?
  installActivatedAt    DateTime?
  jobCards              JobCard[]
  /// Short code this customer shares with neighbours; created the first time it is shown.
  referralCode          String?
  /// Who referred this customer. Their reward is granted once this customer first pays.
  referredById          String?
  referredBy            Customer?           @relation("CustomerReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals             Customer[]          @relation("CustomerReferrals")
  referralRewardedAt    DateTime?
  referralRewardsEarned ReferralReward[]    @relation("ReferralRewardReferrer")
  referralRewardFor     ReferralReward?     @relation("ReferralRewardReferred")
  upgradeSuggestions    UpgradeSuggestion[]
  tenantId              String
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId              String?
  branch                Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId                String?             @unique
  user                  User?               @relation(fields: [userId], references: [id])
  customerNumber        String
  fullName              String
  email                 String?
  phone                 String
  idNumber              String?
  address               String?
  gpsLat                Float?
  gpsLng                Float?
  connectionType        String?
  installationDate      DateTime?
  status                CustomerStatus      @default(PENDING)
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  services CustomerService[]
  invoices Invoice[]
  payments Payment[]
  wallet   Wallet?
  tickets  Ticket[]
  members  CustomerMember[]

  mpesaStkRequests     MpesaStkRequest[]
  mpesaC2BTransactions MpesaC2BTransaction[]
  paystackTransactions PaystackTransaction[]

  gatewayTransactions GatewayTransaction[]
  paymentReferences   PaymentReference[]

  radiusUsers        RadiusUser[]
  provisioningJobs   ProvisioningJob[]
  addOnPurchases     AddOnPurchase[]
  winBackOffers      WinBackOffer[]
  campaignRecipients CampaignRecipient[]
  leads              Lead[]
  supportChats       SupportChat[]

  @@unique([tenantId, customerNumber])
  @@unique([tenantId, referralCode])
  @@index([tenantId, status])
  @@map("customers")
}

enum BillingCycle {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

model Package {
  id                   String             @id @default(uuid())
  tenantId             String
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  downloadKbps         Int
  uploadKbps           Int
  burstDownloadKbps    Int?
  burstUploadKbps      Int?
  dataCapMb            Int?
  billingCycle         BillingCycle       @default(MONTHLY)
  /// Required and used only when billingCycle = CUSTOM.
  durationDays         Int?
  priceMinor           Int
  currency             String             @default("KES")
  installationFeeMinor Int                @default(0)
  activationFeeMinor   Int                @default(0)
  /// Whole-percent tax rate (16 = 16%) — kept as an integer to avoid floating-point tax math.
  taxPercent           Int?
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  // --- Network service configuration (spec section 3) ------------------------------------
  // A package is what determines a subscriber's network setup, so the VLAN, pool, profiles and
  // router live here and are inherited by every CustomerService created from this package.
  // All nullable: packages predating this module have none of it, and a package still bills
  // correctly without it -- what it cannot do is drive automatic provisioning, which is exactly
  // the distinction the provisioning job surfaces rather than silently guessing a default.
  serviceType          NetworkServiceType @default(PPPOE)
  vlanId               String?
  vlan                 Vlan?              @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  ipPoolId             String?
  ipPool               IPPool?            @relation(fields: [ipPoolId], references: [id], onDelete: SetNull)
  /// Names of profiles that must already exist on the device. Stored as free text because they
  /// are the vendor's own identifiers, not something this system owns or can validate offline;
  /// the provisioning job verifies them against the device and fails loudly if absent.
  pppoeProfile         String?
  hotspotProfile       String?
  routerId             String?
  router               Router?            @relation(fields: [routerId], references: [id], onDelete: SetNull)
  fairUsagePolicy      String?

  customerServices CustomerService[]
  hotspotVouchers  HotspotVoucher[]

  @@index([tenantId, isActive])
  @@map("packages")
}

enum CustomerServiceStatus {
  ACTIVE
  SUSPENDED
  PENDING
  CANCELLED
  EXPIRED
}

/// A customer's subscription to a package — the thing that gets billed, and (Phase 4) the
/// thing that gets provisioned on network equipment.
model CustomerService {
  id                 String                @id @default(uuid())
  /// Set while the customer has paused the plan: it stays off until then, and the billing sweep
  /// that turns cleared accounts back on leaves it alone.
  pausedUntil        DateTime?
  pauses             ServicePause[]
  upgradeSuggestions UpgradeSuggestion[]
  tenantId           String
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  packageId          String
  package            Package               @relation(fields: [packageId], references: [id])
  status             CustomerServiceStatus @default(PENDING)
  /// Overrides Package.priceMinor for this specific subscription (custom-negotiated pricing).
  priceOverrideMinor Int?
  startDate          DateTime
  nextBillingAt      DateTime
  autoRenew          Boolean               @default(true)
  cancelledAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  /// Where this subscription stands ON THE NETWORK, as opposed to `status`, which is its
  /// billing state. They genuinely differ: a subscription can be billing-ACTIVE while its
  /// provisioning is FAILED because the router rejected the configuration, and an operator
  /// must be able to see that rather than have one status paper over the other.
  provisioningStatus ServiceProvisioningStatus @default(PENDING)

  invoices         Invoice[]
  radiusUser       RadiusUser?
  provisioningJobs ProvisioningJob[]
  addOnPurchases   AddOnPurchase[]

  @@index([tenantId, status])
  @@index([nextBillingAt])
  @@map("customer_services")
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  VOID
}

model Invoice {
  id                String           @id @default(uuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerServiceId String?
  customerService   CustomerService? @relation(fields: [customerServiceId], references: [id])
  invoiceNumber     String
  status            InvoiceStatus    @default(PENDING)
  subtotalMinor     Int
  taxMinor          Int              @default(0)
  discountMinor     Int              @default(0)
  totalMinor        Int
  amountPaidMinor   Int              @default(0)
  currency          String           @default("KES")
  issuedAt          DateTime         @default(now())
  dueDate           DateTime
  paidAt            DateTime?
  voidedAt          DateTime?
  notes             String?
  /// 0 = no dunning notice sent yet, 1 = "due soon" reminder sent, 2 = overdue notice sent,
  /// 3 = final notice sent (the day before suspendOverdueSubscriptions would act). Monotonic —
  /// only ever moves forward, so the same invoice never gets the same notice emailed twice.
  dunningStage      Int              @default(0)
  lastDunningAt     DateTime?
  /// When the invoice itself was emailed to the customer (the worker's send-pending-invoice-emails
  /// job, or a staff "Email invoice" click). Null until then; set even when the transport is not
  /// configured, so an unconfigured server never re-queues the same invoice every tick.
  emailedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  gatewayTransactions  GatewayTransaction[]
  paymentReference     PaymentReference?
  items                InvoiceItem[]
  payments             Payment[]
  mpesaStkRequests     MpesaStkRequest[]
  paystackTransactions PaystackTransaction[]
  addOnPurchase        AddOnPurchase?

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id             String  @id @default(uuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int     @default(1)
  unitPriceMinor Int
  totalMinor     Int

  @@map("invoice_items")
}

model Wallet {
  id           String   @id @default(uuid())
  customerId   String   @unique
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  balanceMinor Int      @default(0)
  currency     String   @default("KES")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("wallets")
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

/// Append-only ledger — the source of truth. Wallet.balanceMinor is a cached derived value
/// that must only ever change alongside a new row here in the same transaction.
model WalletTransaction {
  id                String                @id @default(uuid())
  walletId          String
  wallet            Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type              WalletTransactionType
  amountMinor       Int
  balanceAfterMinor Int
  reason            String
  referenceType     String?
  referenceId       String?
  createdAt         DateTime              @default(now())

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

enum PaymentMethod {
  MANUAL
  WALLET
  CASH
  BANK_TRANSFER
  MPESA
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

/// Phase 2 shipped manual/staff-recorded payment methods; Phase 3 adds MPESA, produced by the
/// STK/C2B callback flow instead of a staff form (docs/architecture/04-billing-and-payments.md,
/// 10-phase3-plan.md). `recordedByUserId` is null for those — there is no human actor, only a
/// verified Safaricom callback.
model Payment {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Null for a guest hotspot purchase: someone who buys a Wi-Fi voucher on the captive portal
  /// never becomes a Customer row, they just pay and get a code. Requiring a customer here is
  /// why hotspot sales were not recorded as payments at all, and therefore why every revenue
  /// report silently excluded them — for a hotspot-first ISP that is most of the money.
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId        String?
  invoice          Invoice?      @relation(fields: [invoiceId], references: [id])
  method           PaymentMethod
  status           PaymentStatus @default(COMPLETED)
  amountMinor      Int
  currency         String        @default("KES")
  reference        String?
  idempotencyKey   String        @unique
  recordedByUserId String?
  reversedAt       DateTime?
  reversalReason   String?
  createdAt        DateTime      @default(now())

  gatewayTransaction  GatewayTransaction?
  receipt             Receipt?
  mpesaStkRequest     MpesaStkRequest?
  mpesaC2BTxn         MpesaC2BTransaction?
  paystackTransaction PaystackTransaction?

  @@index([tenantId, createdAt])
  @@index([customerId])
  @@map("payments")
}

model Receipt {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId     String   @unique
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  receiptNumber String
  issuedAt      DateTime @default(now())

  @@unique([tenantId, receiptNumber])
  @@map("receipts")
}

// ---------------------------------------------------------------------------------------------
// Phase 3 — M-Pesa and Payments (docs/architecture/04-billing-and-payments.md, 10-phase3-plan.md)
// ---------------------------------------------------------------------------------------------

enum PaymentProviderKind {
  MPESA
  PAYSTACK
}

/// Per-tenant gateway credentials. Sensitive fields are AES-256-GCM-encrypted at rest
/// (packages/shared's encryptAtRest) and are never returned to the client once set — the read
/// endpoint only ever reports whether a credential is configured, not its value.
model PaymentProviderConfig {
  id                      String              @id @default(uuid())
  tenantId                String
  tenant                  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider                PaymentProviderKind
  isActive                Boolean             @default(false)
  consumerKeyEncrypted    String?
  consumerSecretEncrypted String?
  shortcode               String?
  /// "PAYBILL" | "TILL". Daraja treats the two as different transaction types, and sending the
  /// wrong one does not error cleanly -- the STK push is simply never completed by the payer's
  /// handset. A Paybill uses TransactionType=CustomerPayBillOnline with the paybill as both
  /// BusinessShortCode and PartyB; a Buy Goods Till uses CustomerBuyGoodsOnline with the till as
  /// PartyB and the HEAD OFFICE/store number as BusinessShortCode (see `storeNumber`).
  shortcodeType           String              @default("PAYBILL")
  /// Head office / store number, required only for TILL. Safaricom issues this alongside the
  /// till; it is the number the passkey belongs to, so it -- not the till -- is what the STK
  /// password is derived from. Null for Paybill, where the shortcode plays both roles.
  storeNumber             String?
  passkeyEncrypted        String?
  /// Generic single-secret credential slot for providers that only need one API key (Paystack,
  /// and future gateways like IOTEC/ClickPesa/ZenoPay) rather than Daraja's four-part
  /// consumer-key/secret/shortcode/passkey shape.
  secretKeyEncrypted      String?
  /// Public/publishable key counterpart, if the provider has one (Paystack's `pk_...`) — not
  /// encrypted since it's meant to be visible (e.g. to a client-side checkout widget).
  publicKey               String?
  /// "sandbox" | "production" — selects the Daraja API base URL. Paystack itself has no
  /// separate sandbox host (test/live is determined by which secret key is used), but this
  /// field is still shown/stored for a consistent config UI across providers.
  environment             String              @default("sandbox")
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@unique([tenantId, provider])
  @@map("payment_provider_configs")
}

/// One SMS gateway config per tenant (Africa's Talking — the standard provider for Kenya/East
/// Africa) — same encrypted-at-rest shape as PaymentProviderConfig, just a single row per
/// tenant instead of one per provider since a tenant only ever has one SMS sender identity.
model SmsProviderConfig {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isActive        Boolean  @default(false)
  apiKeyEncrypted String?
  username        String?
  senderId        String?
  /// "sandbox" | "production" — selects the Africa's Talking API host.
  environment     String   @default("sandbox")
  /// Text hotspot buyers their voucher code after an M-Pesa purchase. Each text uses the
  /// tenant's own SMS credit, so it can be switched off.
  sendVoucherSms  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("sms_provider_configs")
}

/// A tenant's own Anthropic API key for the hotspot-package assistant (packages/ai) — never
/// this platform's key. The tenant pays for and controls their own usage, same reasoning as
/// every other per-tenant provider credential in this schema.
model AiAssistantConfig {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isActive        Boolean  @default(false)
  apiKeyEncrypted String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("ai_assistant_configs")
}

/// Tawk.to live-chat widget config. `widgetId` is the `<propertyId>/<widgetId>` path Tawk.to's
/// own embed snippet shows you (e.g. "60f1a2.../1abcdefgh") — not a secret, it's meant to sit in
/// client-side HTML, so unlike AiAssistantConfig's API key this is stored plain. Two independent
/// placement toggles (not just one master switch) because a tenant asked specifically to be able
/// to turn each surface on/off on its own, not just everywhere at once.
/// Per-tenant captive-portal branding, shown to anyone who connects to that ISP's WiFi before
/// they log in. This lived in apps/api/data/captive-portal/<slug>.json until it moved here, and
/// that file-based store was the source of three separate defects worth remembering: the write
/// endpoint was unauthenticated (any visitor could rewrite any ISP's support phone number), the
/// slug was interpolated into a filesystem path so it needed its own traversal guard, and the
/// directory had no volume in production, so every deploy silently restored a stale copy baked
/// into the image. All three stop existing once this is a tenant-scoped row like every other
/// config in this schema.
model CaptivePortalConfig {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone           String?
  supportPhone    String?
  brandName       String?
  welcomeTitle    String?
  bannerSubtitle  String?
  activeThemeId   String?
  installationFee String?
  /// The speed/price tiers rendered on the portal. A JSON column rather than its own table:
  /// an ordered display list a tenant edits as a whole, which nothing ever queries into.
  /// Note jsonb normalizes object key order on write, so a row read back is key-reordered
  /// relative to what was sent. Array order (the display order a tenant arranges) IS
  /// preserved, and every value survives intact - verified against a real database. Compare
  /// these field-by-field, never by JSON.stringify equality.
  fiberRates      Json?
  /// The ~30-plugin captive-portal customizer's whole state (theme, mascots, announcements,
  /// support widget, social links, custom CSS/JS, etc — see CaptivePortalPluginsState in
  /// apps/web/src/lib/captive-portal-plugins/types.ts), stored opaquely: the server does not
  /// need to understand this shape, only persist and return it verbatim, the same reasoning as
  /// fiberRates above.
  ///
  /// Previously this entire customizer only ever wrote to the editing admin's own browser
  /// localStorage under an unscoped key — never to this row — so nothing an operator configured
  /// here (a WhatsApp button, social links, FAQs, custom branding) ever reached a real visitor on
  /// their own device. This column is what makes it real.
  pluginsConfig   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("captive_portal_configs")
}

model LiveChatConfig {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isActive            Boolean  @default(false)
  widgetId            String?
  showOnHotspotPortal Boolean  @default(true)
  showOnDashboard     Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("live_chat_configs")
}

enum WhatsappConnectionStatus {
  /// Never paired, or explicitly unlinked from the dashboard.
  DISCONNECTED
  /// Pairing in progress — a QR code is (or is about to be) available for scanning.
  CONNECTING
  CONNECTED
  /// The phone unlinked this device from WhatsApp's own "Linked devices" screen. Distinct from
  /// DISCONNECTED because the saved credentials are now useless and a fresh QR scan is required —
  /// nothing the platform can retry its way out of.
  LOGGED_OUT
}

/// One tenant's own WhatsApp account link, so each ISP messages its customers from its own
/// number rather than everyone sharing a single platform-wide line (the arrangement this
/// replaced, which also forced the inbound bot to ask every customer which ISP they were with).
/// Deliberately stores no credentials: the Baileys session keys live on disk under
/// WHATSAPP_AUTH_STATE_PATH/<tenantId>, and this row is the tenant-visible status record the
/// dashboard reads.
model WhatsappConnection {
  id              String                   @id @default(uuid())
  /// Null identifies the single platform-level line — the one that sends ISP-registration OTPs,
  /// which go out before the tenant that could own a session exists. Postgres treats NULLs as
  /// distinct in a unique index, so @unique alone would allow unlimited platform rows; the
  /// migration adds a partial unique index that pins it to exactly one.
  tenantId        String?                  @unique
  tenant          Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status          WhatsappConnectionStatus @default(DISCONNECTED)
  /// The linked WhatsApp number, read back off the session once pairing completes — shown in the
  /// dashboard so staff can confirm *which* line is connected. Null until first successful pair.
  phoneNumber     String?
  lastConnectedAt DateTime?
  /// Last failure reason, surfaced in the dashboard so a stuck connection is diagnosable without
  /// reading worker logs.
  lastError       String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@map("whatsapp_connections")
}

/// The platform operator's (MASHUPKGRID's) own Daraja credentials — deliberately separate from
/// the per-tenant PaymentProviderConfig table: the 450 KSH onboarding fee is money owed *to the
/// platform*, collected through the platform's own paybill/till, never a tenant's own M-Pesa
/// config (that would just be an ISP paying itself). A singleton — application code always
/// reads/writes the single row, there's no tenantId here at all.
// ============================================================================================
// MashupHost Payment Gateway & Settlement
//
// Money flow: customer payment → verified provider callback → GatewayTransaction (gross, fee,
// net) → append-only TenantLedgerEntry rows → TenantPayout (a settlement) → tenant destination.
// Collection, ledger and settlement are separate records on purpose: nothing ever moves a
// customer's payment straight to a tenant without the ledger recording it first.
//
// Money is integer minor units (cents) throughout, matching the rest of the billing system —
// exact arithmetic with no floating point. Invariants the application relies on (net = gross −
// fee, ledger rows never change, one in-flight settlement per tenant, …) are enforced in the
// database by the CHECK constraints, partial unique indexes and triggers in migration
// 20260923010000_payment_gateway_settlement, not only in code.
// ============================================================================================

enum TenantCollectionMode {
  OWN
  PLATFORM
}

enum TenantLedgerDirection {
  CREDIT
  DEBIT
}

/// What a ledger row represents. The pair (sourceType, sourceId) stays the idempotency key.
enum TenantLedgerEntryType {
  CUSTOMER_PAYMENT
  PLATFORM_FEE
  SETTLEMENT
  SETTLEMENT_REVERSAL
  PAYMENT_REVERSAL
  FEE_REVERSAL
  REFUND
  ADJUSTMENT
}

/// A settlement's lifecycle. SETTLED is only ever reached on provider confirmation (or, for a
/// MANUAL settlement, an audited super-admin action carrying the transfer reference).
enum SettlementStatus {
  REQUESTED
  AWAITING_APPROVAL
  PROCESSING
  SETTLED
  FAILED
  CANCELLED
}

enum SettlementProviderKind {
  MPESA_B2B
  MPESA_B2C
  MANUAL
  SANDBOX
}

enum SettlementTrigger {
  AUTOMATIC
  TENANT_REQUEST
  ADMIN
}

enum SettlementMode {
  AUTOMATIC
  MANUAL
}

enum SettlementFrequency {
  INSTANT
  DAILY
  WEEKLY
  MANUAL
}

enum SettlementDestinationType {
  MPESA_PHONE
  BANK_ACCOUNT
  TILL
  PAYBILL
}

enum DestinationVerificationStatus {
  UNVERIFIED
  VERIFIED
  FAILED
}

enum PaymentEnvironment {
  SANDBOX
  PRODUCTION
}

enum GatewayChannel {
  MPESA_STK
  MPESA_C2B
}

enum GatewayTransactionStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  REVERSED
}

enum TransactionSettlementStatus {
  UNSETTLED
  SETTLEMENT_PENDING
  SETTLED
}

enum PaymentReferencePurpose {
  CUSTOMER_ACCOUNT
  INVOICE
}

enum GatewayRefundKind {
  REFUND
  REVERSAL
}

enum GatewayRefundStatus {
  PENDING_CUSTOMER_PAYOUT
  COMPLETED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  IGNORED
  REJECTED
  FAILED
}

/// Append-only: a database trigger rejects UPDATE and DELETE. Corrections are new rows.
model TenantLedgerEntry {
  id                   String                @id @default(uuid())
  tenantId             String
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  direction            TenantLedgerDirection
  entryType            TenantLedgerEntryType
  amountMinor          Int
  currency             String                @default("KES")
  description          String
  sourceType           String
  sourceId             String
  gatewayTransactionId String?
  gatewayTransaction   GatewayTransaction?   @relation(fields: [gatewayTransactionId], references: [id], onDelete: Restrict)
  settlementId         String?
  settlement           TenantPayout?         @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  createdByUserId      String?
  createdAt            DateTime              @default(now())

  @@unique([sourceType, sourceId])
  @@index([tenantId, createdAt])
  @@index([gatewayTransactionId])
  @@index([settlementId])
  @@map("tenant_ledger_entries")
}

/// A settlement: money this platform sends a tenant. Kept as the existing tenant_payouts table
/// (extended) rather than a second, parallel settlements table.
model TenantPayout {
  id                       String                 @id @default(uuid())
  settlementNumber         String                 @unique
  tenantId                 String
  tenant                   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  amountMinor              Int
  currency                 String                 @default("KES")
  destinationId            String?
  destination              SettlementDestination? @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  /// The destination exactly as it was when the settlement was created (masked).
  destinationSnapshot      Json?
  destinationShortcode     String?
  destinationType          String
  provider                 SettlementProviderKind @default(MPESA_B2B)
  environment              PaymentEnvironment     @default(PRODUCTION)
  trigger                  SettlementTrigger      @default(AUTOMATIC)
  status                   SettlementStatus       @default(REQUESTED)
  requestedByUserId        String?
  approvedByUserId         String?
  approvedAt               DateTime?
  processingStartedAt      DateTime?
  conversationId           String?
  originatorConversationId String?                @unique
  /// The provider's own reference for the transfer (M-Pesa TransactionID, or a manual bank ref).
  transactionId            String?
  resultCode               Int?
  resultDesc               String?
  failureReason            String?
  providerConfirmedAt      DateTime?
  /// Daraja reported a queue timeout: outcome unknown, held for review — never auto-failed.
  timedOutAt               DateTime?
  retryOfId                String?                @unique
  retryOf                  TenantPayout?          @relation("SettlementRetry", fields: [retryOfId], references: [id], onDelete: Restrict)
  retry                    TenantPayout?          @relation("SettlementRetry")
  resolvedByUserId         String?
  notes                    String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  /// When the settlement reached SETTLED.
  completedAt              DateTime?
  failedAt                 DateTime?
  cancelledAt              DateTime?

  ledgerEntries       TenantLedgerEntry[]
  gatewayTransactions GatewayTransaction[]

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("tenant_payouts")
}

model SettlementDestination {
  id                         String                        @id @default(uuid())
  tenantId                   String
  tenant                     Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  type                       SettlementDestinationType
  accountName                String
  phone                      String?
  bankName                   String?
  bankBranch                 String?
  bankAccountNumberEncrypted String?
  bankAccountLast4           String?
  tillNumber                 String?
  paybillNumber              String?
  paybillAccountReference    String?
  /// VERIFIED once a provider has confirmed a settlement to this destination.
  verificationStatus         DestinationVerificationStatus @default(UNVERIFIED)
  verifiedAt                 DateTime?
  isActive                   Boolean                       @default(true)
  deactivatedAt              DateTime?
  createdByUserId            String?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt

  settlements TenantPayout[]

  @@index([tenantId, isActive])
  @@map("settlement_destinations")
}

/// One row per payment the platform collected on a tenant's behalf. Amounts are immutable
/// (trigger); only status, refunded total and settlement linkage change afterwards.
model GatewayTransaction {
  id                 String                      @id @default(uuid())
  txnNumber          String                      @unique
  tenantId           String
  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  paymentId          String                      @unique
  payment            Payment                     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  customerId         String?
  customer           Customer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoiceId          String?
  invoice            Invoice?                    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentReferenceId String?
  paymentReference   PaymentReference?           @relation(fields: [paymentReferenceId], references: [id], onDelete: SetNull)
  channel            GatewayChannel
  /// M-Pesa receipt number (may start PRV- until Safaricom's own receipt arrives).
  providerReference  String
  /// STK CheckoutRequestID, when collected by STK push.
  providerRequestId  String?
  payerPhone         String?
  environment        PaymentEnvironment
  currency           String                      @default("KES")
  grossMinor         Int
  feeMinor           Int
  netMinor           Int
  /// The fee rule in force when this payment landed — changing the fee never rewrites history.
  feePercentBps      Int
  feeFixedMinor      Int
  refundedMinor      Int                         @default(0)
  status             GatewayTransactionStatus    @default(COMPLETED)
  settlementStatus   TransactionSettlementStatus @default(UNSETTLED)
  settlementId       String?
  settlement         TenantPayout?               @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  description        String
  completedAt        DateTime                    @default(now())
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  ledgerEntries TenantLedgerEntry[]
  refunds       GatewayRefund[]

  @@unique([channel, providerReference])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([settlementId])
  @@index([customerId])
  @@index([createdAt])
  @@map("gateway_transactions")
}

/// A reference a customer pays against, which is what routes a platform-collected payment to
/// the right tenant, customer and invoice — never the payer's phone number.
model PaymentReference {
  id         String                  @id @default(uuid())
  reference  String                  @unique
  tenantId   String
  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customerId String?
  customer   Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoiceId  String?                 @unique
  invoice    Invoice?                @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  purpose    PaymentReferencePurpose
  createdAt  DateTime                @default(now())

  gatewayTransactions GatewayTransaction[]
  stkRequests         MpesaStkRequest[]

  @@index([tenantId])
  @@index([customerId])
  @@map("payment_references")
}

model GatewayRefund {
  id                   String              @id @default(uuid())
  refundNumber         String              @unique
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  gatewayTransactionId String
  gatewayTransaction   GatewayTransaction  @relation(fields: [gatewayTransactionId], references: [id], onDelete: Restrict)
  kind                 GatewayRefundKind
  amountMinor          Int
  /// The share of the platform fee handed back to the tenant with this refund.
  feeReturnedMinor     Int
  reason               String
  status               GatewayRefundStatus
  externalReference    String?
  createdByUserId      String?
  completedByUserId    String?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([gatewayTransactionId])
  @@index([tenantId, createdAt])
  @@map("gateway_refunds")
}

/// Every inbound provider callback, processed or not — including duplicates and rejections.
model PaymentWebhookEvent {
  id                   String             @id @default(uuid())
  provider             String
  eventType            String
  externalId           String?
  tenantId             String?
  tenant               Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  status               WebhookEventStatus @default(RECEIVED)
  transactionReference String?
  payload              Json
  response             Json?
  errorMessage         String?
  sourceIp             String?
  receivedAt           DateTime           @default(now())
  processedAt          DateTime?

  @@index([provider, eventType, externalId])
  @@index([receivedAt])
  @@index([status, receivedAt])
  @@index([tenantId, receivedAt])
  @@map("payment_webhook_events")
}

/// Platform-wide gateway and settlement policy (singleton, id = "platform").
model PlatformSettlementSettings {
  id                     String              @id @default("platform")
  gatewayEnabled         Boolean             @default(false)
  feePercentBps          Int                 @default(0)
  feeFixedMinor          Int                 @default(0)
  settlementMode         SettlementMode      @default(AUTOMATIC)
  settlementFrequency    SettlementFrequency @default(INSTANT)
  settlementMinimumMinor Int                 @default(100)
  /// Hour of day (Africa/Nairobi) DAILY/WEEKLY runs happen.
  settlementHourEat      Int                 @default(9)
  /// ISO weekday (1 = Monday) for WEEKLY runs.
  settlementWeekday      Int                 @default(1)
  lastScheduledRunAt     DateTime?
  updatedByUserId        String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@map("platform_settlement_settings")
}

model PlatformMpesaConfig {
  id                              String   @id @default(uuid())
  isActive                        Boolean  @default(false)
  consumerKeyEncrypted            String?
  consumerSecretEncrypted         String?
  shortcode                       String?
  passkeyEncrypted                String?
  /// B2B initiator. Separate Daraja product from STK Push with its own approval: the initiator
  /// name, and that user's password encrypted against Safaricom's public certificate (the
  /// operator generates that blob and pastes it — this platform never sees the plain password).
  initiatorName                   String?
  initiatorCredentialEncrypted    String?
  /// Smallest balance, in cents, an automatic payout run will send. A platform decision rather
  /// than an env var: whether a B2B fee is worth paying on a small balance is a commercial
  /// judgement the operator makes and changes, not something that should need a redeploy.
  /// Defaults to 1 — every cent collected is remitted.
  b2cShortcode                    String?
  b2cInitiatorName                String?
  b2cInitiatorCredentialEncrypted String?
  payoutMinimumMinor              Int      @default(1)
  environment                     String   @default("sandbox")
  /// --- Donate / "Buy Me a Coffee" M-Pesa gateway ---
  /// When true, the public donate page's M-Pesa STK push is enabled. When false, only the
  /// manual Paybill fallback instructions are shown.
  donateEnabled                   Boolean  @default(false)
  /// The Paybill or Till number displayed on the donate page's manual fallback instructions,
  /// and used as the collecting shortcode for donation STK pushes when the platform's own
  /// credentials are configured. Null means "use the platform shortcode".
  donatePaybill                   String?
  /// The M-Pesa account reference shown to donors (e.g. "COFFEE"). Defaults to "COFFEE" in
  /// application code when null.
  donateAccountReference          String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@map("platform_mpesa_config")
}

/// Tracks "Buy Me a Coffee" / donation M-Pesa STK pushes. Separate from MpesaStkRequest because
/// donations have no tenant, no customer, no invoice — they are platform-level tips from the
/// public. The callback finds and completes these by checkoutRequestId, same as tenant payments.
/// Hardware sold on the public store (/shop). Prices in cents, like every other amount here.
model StoreProduct {
  /// Kept stable (e.g. "prod_mikrotik_hex") so carts and past orders keep pointing at the item.
  id                 String   @id
  slug               String   @unique
  name               String
  brand              String
  /// routers | switches | wireless | fiber | solar | cctv
  category           String
  priceMinor         Int
  originalPriceMinor Int?
  stock              Int      @default(0)
  badge              String?
  shortDescription   String
  description        String
  imageUrl           String
  specs              String[]
  warranty           String
  featured           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("store_products")
}

enum StoreOrderStatus {
  /// Waiting for M-Pesa, or for payment on delivery.
  PENDING
  /// M-Pesa confirmed the payment. Never set from anything the buyer's browser sends.
  PAID
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum StorePaymentMethod {
  MPESA
  PAY_ON_DELIVERY
}

model StoreOrder {
  id                 String             @id @default(uuid())
  /// What the buyer sees and tracks by, e.g. "ORD-482913".
  orderNumber        String             @unique
  customerName       String
  phone              String
  email              String?
  county             String
  deliveryAddress    String
  /// Snapshot at order time: [{ productId, name, quantity, priceMinor }].
  items              Json
  subtotalMinor      Int
  shippingMinor      Int
  totalMinor         Int
  paymentMethod      StorePaymentMethod
  status             StoreOrderStatus   @default(PENDING)
  checkoutRequestId  String?            @unique
  mpesaReceiptNumber String?            @unique
  /// Why the last M-Pesa attempt didn't complete (cancelled, insufficient funds, …).
  paymentNote        String?
  paidAt             DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([phone])
  @@index([createdAt])
  @@map("store_orders")
}

model Donation {
  id                 String   @id @default(uuid())
  phone              String
  amountMinor        Int
  donorName          String?
  donorMessage       String?
  /// The donor chose to show their name and message on the public supporters wall. Off for
  /// every donation made before donors were asked.
  showPublicly       Boolean  @default(false)
  merchantRequestId  String
  checkoutRequestId  String   @unique
  status             String   @default("PENDING") // PENDING | COMPLETED | FAILED | CANCELLED
  resultCode         Int?
  resultDesc         String?
  mpesaReceiptNumber String?  @unique
  rawCallback        Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("donations")
}

/// "Sign in with Google" is platform-wide, same reasoning as PlatformMpesaConfig — one OAuth app
/// registered against this deployment's own fixed domain serves every tenant. Was previously an
/// A hostname, wildcard or IP a hotspot customer may reach BEFORE logging in, on every router on
/// the platform. The platform's own hosts and the payment gateways are built in (see
/// packages/radius setup-script.ts); this is what a super admin adds on top — a new gateway, a
/// support site, an app's CDN — from the dashboard, without a code release. Applied by the
/// setup script of every router linked from then on and by the hotspot self-repair pass on
/// routers already online.
model PlatformWalledGardenHost {
  id              String   @id @default(uuid())
  /// "example.com", "*.example.com" or "203.0.113.5"; validated in packages/network walled-garden.ts.
  host            String   @unique
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@map("platform_walled_garden_hosts")
}

/// env-var-only setting (GOOGLE_OAUTH_CLIENT_ID); moved into the DB once a super admin needed to
/// toggle/edit it from the dashboard instead of editing .env and restarting the API. `clientId`
/// is not a secret — it's the OAuth `aud` value, meant to sit in the frontend bundle.
model PlatformGoogleAuthConfig {
  id        String   @id @default(uuid())
  isActive  Boolean  @default(false)
  clientId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_google_auth_config")
}

/// One row per tenant, created alongside it — tracks the one-time 450 KSH onboarding fee
/// separately from MpesaStkRequest (which is always tenant-scoped billing *within* a tenant,
/// e.g. a customer paying their ISP) since this is the reverse direction: the tenant paying the
/// platform. Reuses MpesaTransactionStatus since the state machine is identical.
model TenantOnboardingFee {
  id                 String                 @id @default(uuid())
  tenantId           String                 @unique
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amountMinor        Int                    @default(45000)
  phone              String?
  status             MpesaTransactionStatus @default(PENDING)
  merchantRequestId  String?
  checkoutRequestId  String?                @unique
  mpesaReceiptNumber String?
  resultDesc         String?
  rawCallback        Json?
  paidAt             DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@map("tenant_onboarding_fees")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum SubscriptionBillingCycle {
  MONTHLY
  ANNUAL
}

/// The platform's sellable subscription catalog — what a super admin offers to ISP tenant
/// businesses (NOT the ISP's own internet-speed pricing tiers, see the `Package` model for that).
/// Deliberately named `TenantPlan` rather than bare `Plan` to avoid colliding with that existing,
/// unrelated concept. `Tenant.planTier` (a decorative, unenforced string) predates this model and
/// is left untouched — fully superseded by `TenantSubscription` going forward.
model TenantPlan {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  description       String?
  monthlyPriceMinor Int
  annualPriceMinor  Int?
  /// Replaces the previously-hardcoded TRIAL_DAYS constant — trial length is now per-plan.
  trialDays         Int      @default(7)
  /// Null = unlimited. Only customers/routers are enforced today (see plan-limits.ts) — no
  /// staff-seat or SMS/month fields here since nothing creates staff or counts SMS yet to check
  /// a limit against.
  maxCustomers      Int?
  maxRouters        Int?
  /// Subset of packages/shared's TENANT_FEATURES — what this plan includes. Checked alongside
  /// (not instead of) Tenant.disabledFeatures by requireFeature.
  features          String[] @default([])
  isDefault         Boolean  @default(false)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions TenantSubscription[]

  @@map("tenant_plans")
}

/// One row per tenant — the tenant's current commercial/billing state, distinct from
/// `Tenant.status` (the actual access-control gate `resolveTenant` checks). The worker's
/// expire-trials job is what keeps the two in sync (PAST_DUE -> grace period -> Tenant SUSPENDED).
model TenantSubscription {
  id                 String                   @id @default(uuid())
  tenantId           String                   @unique
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId             String
  plan               TenantPlan               @relation(fields: [planId], references: [id])
  billingCycle       SubscriptionBillingCycle @default(MONTHLY)
  status             SubscriptionStatus       @default(TRIALING)
  currentPeriodStart DateTime                 @default(now())
  currentPeriodEnd   DateTime
  /// Set when status flips to PAST_DUE — the worker job suspends the tenant once this passes.
  gracePeriodEndsAt  DateTime?
  cancelAtPeriodEnd  Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  payments TenantSubscriptionPayment[]

  @@map("tenant_subscriptions")
}

/// Mirrors TenantOnboardingFee's shape (same state machine, same reused MpesaTransactionStatus
/// enum) but recurring — one row per billing-period charge attempt, not a single row per tenant.
model TenantSubscriptionPayment {
  id                 String                   @id @default(uuid())
  tenantId           String
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId     String
  subscription       TenantSubscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amountMinor        Int
  billingCycle       SubscriptionBillingCycle
  periodStart        DateTime
  periodEnd          DateTime
  phone              String?
  status             MpesaTransactionStatus   @default(PENDING)
  merchantRequestId  String?
  checkoutRequestId  String?                  @unique
  mpesaReceiptNumber String?
  resultDesc         String?
  rawCallback        Json?
  paidAt             DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([tenantId])
  @@map("tenant_subscription_payments")
}

/// A super admin's message to tenant staff — `tenantId` null means platform-wide (every tenant
/// sees it), set means targeted at one tenant only (e.g. "your trial ends in 2 days"). Shown as
/// a dashboard banner on next login/page-load; `AnnouncementDismissal` is per-user so dismissing
/// it doesn't hide it from the tenant's other staff.
model PlatformAnnouncement {
  id              String               @id @default(uuid())
  tenantId        String?
  tenant          Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String
  body            String
  severity        AnnouncementSeverity @default(INFO)
  createdByUserId String?
  createdAt       DateTime             @default(now())
  expiresAt       DateTime?

  dismissals AnnouncementDismissal[]

  @@index([tenantId])
  @@map("platform_announcements")
}

model AnnouncementDismissal {
  id             String               @id @default(uuid())
  announcementId String
  announcement   PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  dismissedAt    DateTime             @default(now())

  @@unique([announcementId, userId])
  @@map("announcement_dismissals")
}

enum AnnouncementSeverity {
  INFO
  WARNING
  CRITICAL
}

enum DomainStatus {
  PENDING
  CHECKING
  VERIFIED
  DNS_ERROR
  SSL_PENDING
  SSL_ACTIVE
  SUSPENDED
  REMOVED
}

/// A tenant's custom domain (e.g. "billing.mashupnet.co.ke"). Deliberately does NOT represent
/// the automatic platform subdomain from Tenant.slug — that one needs no row here at all (see
/// the multi-tenant-domains plan); this table exists purely for domains an ISP connects
/// themselves. `isPrimary` lives here rather than a `Tenant.primaryDomainId` FK to avoid a
/// circular relation — at most one row per tenant has it true, enforced in the set-primary
/// route handler. When no row is primary, the tenant's platform subdomain is the implicit
/// primary, which is why it must always keep working as a fallback.
model Domain {
  id                String       @id @default(uuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostname          String       @unique
  status            DomainStatus @default(PENDING)
  isPrimary         Boolean      @default(false)
  /// Not required for the CNAME-target verification this platform actually does (see
  /// apps/api's domains route) — stored for a possible future TXT-record verification path.
  verificationToken String
  lastCheckedAt     DateTime?
  lastError         String?
  verifiedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([tenantId])
  @@map("domains")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// A support request — from a logged-in subscriber (customerId set), a walk-in hotspot customer
/// with no account (customerId null, identified only by contactName/Phone/Email), or staff on a
/// customer's behalf. The `tickets.read`/`tickets.manage` permissions already existed in the RBAC
/// catalog (packages/shared/src/permissions.ts) with nothing to point them at — this is that.
model Ticket {
  id               String         @id @default(uuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer?      @relation(fields: [customerId], references: [id])
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  subject          String
  status           TicketStatus   @default(OPEN)
  priority         TicketPriority @default(NORMAL)
  /// Where this ticket came from — lets staff tell a walk-in hotspot report apart from a
  /// logged-in subscriber's own request at a glance, without parsing contact fields.
  source           String         @default("STAFF")
  assignedToUserId String?
  assignedToUser   User?          @relation("TicketAssignee", fields: [assignedToUserId], references: [id])
  createdByUserId  String?
  createdByUser    User?          @relation("TicketCreatedBy", fields: [createdByUserId], references: [id])
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  messages    TicketMessage[]
  supportChat SupportChat?

  @@index([tenantId, status])
  @@map("tickets")
}

/// A ticket's message thread. `isInternalNote` messages never leave the staff dashboard — the
/// customer-facing routes (both /me/tickets and the public hotspot one) filter them out entirely
/// rather than trusting the frontend not to render them, the same "scoping is the security
/// boundary" principle me.ts already documents for customer-owned records.
model TicketMessage {
  id             String   @id @default(uuid())
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId   String?
  authorUser     User?    @relation(fields: [authorUserId], references: [id])
  /// Display name for a message from someone with no User row (a walk-in hotspot contact) —
  /// authorUserId is null in exactly that case.
  authorLabel    String?
  body           String
  isInternalNote Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_messages")
}

enum MpesaTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

/// One row per Lipa na M-Pesa Online (STK Push) request. Created PENDING at initiation; only
/// the verified callback (or a server-initiated status query) may move it to
/// COMPLETED/FAILED/CANCELLED — never the initiating request itself (project instruction §13).
model MpesaStkRequest {
  id                 String                 @id @default(uuid())
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           Customer?              @relation(fields: [customerId], references: [id])
  invoiceId          String?
  invoice            Invoice?               @relation(fields: [invoiceId], references: [id])
  hotspotPackageId   String?
  hotspotPackage     HotspotPackage?        @relation(fields: [hotspotPackageId], references: [id])
  hotspotVoucherCode String?
  initiatedByUserId  String?
  phone              String
  amountMinor        Int
  merchantRequestId  String
  checkoutRequestId  String                 @unique
  status             MpesaTransactionStatus @default(PENDING)
  resultCode         Int?
  resultDesc         String?
  mpesaReceiptNumber String?                @unique
  paymentId          String?                @unique
  payment            Payment?               @relation(fields: [paymentId], references: [id])
  /// The raw callback payload, stored verbatim before any business logic runs — the source
  /// record survives even if a processing bug loses the parsed result.
  /// Whose account collected this push, fixed when it was initiated. The ledger is credited only
  /// for PLATFORM collections, whatever the tenant's mode is by the time the callback lands.
  collectedBy        TenantCollectionMode   @default(OWN)
  paymentReferenceId String?
  paymentReference   PaymentReference?      @relation(fields: [paymentReferenceId], references: [id], onDelete: SetNull)
  rawCallback        Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([tenantId, status])
  @@map("mpesa_stk_requests")
}

/// One row per C2B (Paybill) confirmation Safaricom sends us. `matchedCustomerId`/`paymentId`
/// are null until reconciliation (automatic by BillRefNumber, or manual in the admin UI)
/// resolves which customer/invoice the payment belongs to.
model MpesaC2BTransaction {
  id                String               @id @default(uuid())
  /// Null only for a payment to the PLATFORM paybill whose reference matched no tenant yet.
  tenantId          String?
  tenant            Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId     String               @unique
  shortcode         String
  amountMinor       Int
  msisdn            String
  billRefNumber     String?
  transactionTime   DateTime
  matchedCustomerId String?
  matchedCustomer   Customer?            @relation(fields: [matchedCustomerId], references: [id])
  paymentId         String?              @unique
  payment           Payment?             @relation(fields: [paymentId], references: [id])
  collectedBy       TenantCollectionMode @default(OWN)
  assignedByUserId  String?
  rawPayload        Json
  reconciled        Boolean              @default(false)
  createdAt         DateTime             @default(now())

  @@index([tenantId, reconciled])
  @@map("mpesa_c2b_transactions")
}

enum PaystackTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  ABANDONED
}

/// Mirrors MpesaStkRequest's shape: a row created PENDING the moment we initiate a Paystack
/// transaction, only ever moved to COMPLETED/FAILED by a verified webhook or an explicit
/// verify-transaction call — never by the initiating request returning successfully.
model PaystackTransaction {
  id                   String                    @id @default(uuid())
  tenantId             String
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId           String?
  customer             Customer?                 @relation(fields: [customerId], references: [id])
  invoiceId            String?
  invoice              Invoice?                  @relation(fields: [invoiceId], references: [id])
  hotspotPackageId     String?
  hotspotPackage       HotspotPackage?           @relation(fields: [hotspotPackageId], references: [id])
  hotspotVoucherCode   String?
  /// The router's own `link-login-only` URL, captured from the captive-portal page at purchase
  /// time — Paystack's checkout is a full off-site redirect, so it's the only way the browser
  /// still knows where to POST the voucher back to once it returns (see /return in
  /// apps/api/src/routes/paystack.ts). Null for a non-hotspot Paystack transaction.
  hotspotLinkLoginOnly String?
  /// The email actually charged for a guest hotspot purchase (Paystack requires one, but until
  /// now nothing persisted it) — without this a Paystack-paid hotspot customer has no identity
  /// on the transaction row at all, unlike M-Pesa's `phone`. Null for a non-hotspot transaction,
  /// where the buyer is always a known `Customer` via `customerId` instead.
  hotspotEmail         String?
  /// The phone the guest gave at checkout. Already collected by the purchase form and passed
  /// into initiatePaystackHotspotPurchase all along, but previously discarded — it's what the
  /// voucher's WhatsApp delivery is addressed to, the same role MpesaStkRequest.phone plays for
  /// the M-Pesa path. Null for a non-hotspot transaction.
  hotspotPhone         String?
  initiatedByUserId    String?
  reference            String                    @unique
  amountMinor          Int
  currency             String                    @default("KES")
  status               PaystackTransactionStatus @default(PENDING)
  authorizationUrl     String?
  gatewayResponse      String?
  paymentId            String?                   @unique
  payment              Payment?                  @relation(fields: [paymentId], references: [id])
  /// The raw webhook/verify payload, stored verbatim before any business logic runs — same
  /// "source record survives a processing bug" rationale as MpesaStkRequest.rawCallback.
  rawWebhook           Json?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([tenantId, status])
  @@map("paystack_transactions")
}

// ---------------------------------------------------------------------------------------------
// Phase 4 — Network: MikroTik, RADIUS/AAA, IPAM (docs/architecture/06-network-mikrotik-radius.md,
// 13-phase4-plan.md)
// ---------------------------------------------------------------------------------------------

enum RouterVendor {
  MIKROTIK
}

enum RouterStatus {
  UNKNOWN
  ONLINE
  WARNING
  DOWN
}

/// Router credentials are AES-256-GCM encrypted at rest — decrypted only in-process by
/// apps/api / apps/worker, never sent to apps/web (docs/architecture/06).
model Router {
  id                   String                @id @default(uuid())
  healthSamples        RouterHealthSample[]
  backups              RouterBackup[]
  /// Last seen by the Router updates page: RouterOS version, board model and bootloader firmware.
  routerOsVersion      String?
  boardName            String?
  firmwareVersion      String?
  versionCheckedAt     DateTime?
  /// The RouterOS major version (6 or 7) the ISP said this router runs when adding it; null = let
  /// the setup script detect it. Shapes the script (v6 gets no WireGuard, its own NTP syntax).
  routerOsMajor        Int?
  rolloutTargets       RouterRolloutTarget[]
  tenantId             String
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  vendor               RouterVendor          @default(MIKROTIK)
  /// Where the router physically is: a site or branch name and, when known, coordinates for the
  /// network map. All optional; nothing else depends on them.
  siteName             String?
  branchId             String?
  branch               Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  latitude             Float?
  longitude            Float?
  /// Null until the router either calls home (see provisionTokenHash) or an admin fills it in
  /// manually — a row can exist "pending" with generated credentials but no known address yet.
  host                 String?
  apiPort              Int                   @default(8728)
  useTls               Boolean               @default(false)
  usernameEncrypted    String
  passwordEncrypted    String
  /// Hash of the one-time token embedded in the paste-and-run provisioning script — the router
  /// itself presents this token when it calls back to /routers/provision/:token/callback, which
  /// is how `host` above gets populated without an admin ever typing an IP. Null for routers
  /// linked the old manual-entry way (host/credentials filled in directly).
  provisionTokenHash   String?               @unique
  provisionedAt        DateTime?
  /// WireGuard remote access — lets the platform reach this router's API even when it has no
  /// public IP / is behind NAT (the common case for a real customer-premises router), instead
  /// of requiring `host` to already be directly reachable. Once set, `host` is updated to this
  /// tunnel IP so every existing host-based feature (test-connection, hotspot script, live
  /// sessions) keeps working unchanged — nothing else in the app needs to know VPN exists.
  vpnRegisterTokenHash String?               @unique
  vpnPublicKey         String?
  vpnIp                String?
  vpnConfiguredAt      DateTime?
  /// Public TCP port on the platform server that the WinBox relay forwards, over this router's
  /// WireGuard tunnel, to its WinBox service (8291). Assigned once the router has a vpnIp.
  winboxRelayPort      Int?                  @unique
  status               RouterStatus          @default(UNKNOWN)
  /// PPPoE server settings, per router because they are a network-design choice that differs by
  /// site: which port or VLAN faces the subscribers, and what addresses they are handed. Left
  /// null on a hotspot-only router, in which case the provisioning script emits no PPPoE section
  /// at all rather than imposing an addressing plan that could collide with a live network.
  /// The interface PPPoE listens on (e.g. "ether2", "vlan100", or the LAN bridge).
  pppoeInterface       String?
  /// The gateway address subscribers see, e.g. "10.10.0.1". Must sit outside pppoePoolRange.
  pppoeGatewayIp       String?
  /// RouterOS pool range for subscriber addresses, e.g. "10.10.0.2-10.10.255.254".
  pppoePoolRange       String?
  /// Drop traffic that arrived via a customer's own phone hotspot or travel router, so one
  /// voucher cannot serve a whole room. Off by default because the detection is TTL-based and
  /// therefore imperfect — see buildAntiTetheringSection for exactly who it can wrongly block.
  blockTethering       Boolean               @default(false)
  /// Physical ports / interfaces running the Hotspot captive portal (e.g. ["ether2", "ether3"]).
  /// If empty, defaults to standard LAN bridge ports (ether2, ether3, ether4, wlan1).
  hotspotPorts         String[]              @default([])
  /// Dedicated direct LAN / non-hotspot port (e.g. "ether4" or "ether5") with no captive portal.
  lanPort              String?
  lastSeenAt           DateTime?
  lastError            String?
  cpuLoadPercent       Int?
  memoryUsedBytes      BigInt?
  memoryTotalBytes     BigInt?
  uptimeSeconds        Int?
  /// From the router's own report (heartbeat) or a live API read; null where the board has no sensor.
  temperatureC         Float?
  voltageV             Float?
  diskFreeBytes        BigInt?
  diskTotalBytes       BigInt?
  /// Hotspot users signed in on the router at its last report.
  activeUsers          Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?

  vlans            Vlan[]
  packages         Package[]
  ipPools          IPPool[]
  radiusNas        RadiusNas[]
  syncTasks        NetworkSyncTask[]
  provisioningJobs ProvisioningJob[]

  @@index([tenantId, status])
  @@map("routers")
}

enum IpVersion {
  IPV4
  IPV6
}

/// A pool of addresses to hand out (matches MikroTik's `/ip pool` and FreeRADIUS's
/// `Framed-Pool` reply attribute). Dual-stack from the start (project instruction §21) —
/// `version` distinguishes an IPv4 pool from a delegated IPv6 prefix pool.
model IPPool {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routerId   String?
  router     Router?   @relation(fields: [routerId], references: [id])
  name       String
  version    IpVersion @default(IPV4)
  cidr       String
  gateway    String?
  dnsServers String[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  addresses IPAddress[]
  vlans     Vlan[]
  packages  Package[]

  @@unique([tenantId, name])
  @@map("ip_pools")
}

enum IPAddressStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
}

model IPAddress {
  id                     String          @id @default(uuid())
  tenantId               String
  tenant                 Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  poolId                 String
  pool                   IPPool          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  address                String
  status                 IPAddressStatus @default(AVAILABLE)
  assignedToRadiusUserId String?         @unique
  assignedToRadiusUser   RadiusUser?     @relation(fields: [assignedToRadiusUserId], references: [id])
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([poolId, address])
  @@index([tenantId, status])
  @@map("ip_addresses")
}

/// FreeRADIUS's `nas` table shape (nasname/shortname/type/secret) — a real FreeRADIUS
/// instance's rlm_sql module reads this directly. The shared `secret` column is intentionally
/// plaintext, matching stock FreeRADIUS schema: the AAA server has no way to decrypt an
/// application-level ciphertext, the same reason `nas.secret` is plaintext in every real
/// FreeRADIUS deployment (access is controlled at the DB layer, not by app-side encryption).
model RadiusNas {
  id        Int      @id @default(autoincrement())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routerId  String?
  router    Router?  @relation(fields: [routerId], references: [id])
  nasname   String
  shortname String
  type      String   @default("other")
  ports     Int?
  secret    String
  createdAt DateTime @default(now())

  @@unique([nasname])
  @@index([tenantId])
  @@map("nas")
}

enum RadiusUserStatus {
  ACTIVE
  SUSPENDED
}

/// Our application's view of a PPPoE/Hotspot account — owns the relationship to
/// Customer/CustomerService/Tenant that bare `radcheck` rows can't express. Kept in sync with
/// `RadCheck`/`RadReply` by packages/radius's provisioning service (docs/architecture/06).
model RadiusUser {
  id                String           @id @default(uuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerServiceId String           @unique
  customerService   CustomerService  @relation(fields: [customerServiceId], references: [id], onDelete: Cascade)
  username          String           @unique
  /// AES-256-GCM at rest in *this* table; the provisioning service decrypts it once to mirror
  /// the plaintext into `RadCheck` (Cleartext-Password), which is what FreeRADIUS actually
  /// reads — see the RadiusNas.secret comment for why that mirror can't itself be encrypted.
  passwordEncrypted String
  status            RadiusUserStatus @default(ACTIVE)
  connectionType    String           @default("PPPOE")
  staticIp          String?
  downloadKbps      Int?
  uploadKbps        Int?
  simultaneousUse   Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  assignedIp IPAddress?
  syncTasks  NetworkSyncTask[]

  @@index([tenantId, status])
  @@map("radius_users")
}

/// FreeRADIUS `radcheck` — one row per (username, attribute). The provisioning service always
/// writes a `Cleartext-Password` row, and (for suspension) an `Auth-Type := Reject` row rather
/// than deleting the account, which is the standard FreeRADIUS idiom for "account exists but
/// may not authenticate" (preserves accounting history / avoids an "unknown user" reject).
model RadCheck {
  id        Int    @id @default(autoincrement())
  username  String
  attribute String
  op        String @default("==")
  value     String

  @@index([username])
  @@map("radcheck")
}

/// FreeRADIUS `radreply` — reply attributes on Access-Accept: rate limit (Mikrotik-Rate-Limit),
/// static/pool IP assignment (Framed-IP-Address / Framed-Pool), session timeout, etc.
model RadReply {
  id        Int    @id @default(autoincrement())
  username  String
  attribute String
  op        String @default("=")
  value     String

  @@index([username])
  @@map("radreply")
}

/// FreeRADIUS `radacct` — accounting (session) records. A practical subset of the full stock
/// column set (documented in docs/architecture/13-phase4-plan.md as a scope note, not a claim
/// of 100% upstream schema parity). This is the highest-volume table in the system and is a
/// declared range-partitioning candidate by month once real accounting volume exists — see
/// docs/architecture/01-database-erd-and-schema.md's indexing note; not partitioned yet since
/// Phase 4 has no live traffic to partition.
model RadAcct {
  radacctId          BigInt    @id @default(autoincrement()) @map("radacctid")
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  acctSessionId      String    @map("acctsessionid")
  acctUniqueId       String    @unique @map("acctuniqueid")
  username           String
  nasIpAddress       String    @map("nasipaddress")
  nasPortId          String?   @map("nasportid")
  nasPortType        String?   @map("nasporttype")
  acctStartTime      DateTime? @map("acctstarttime")
  acctUpdateTime     DateTime? @map("acctupdatetime")
  acctStopTime       DateTime? @map("acctstoptime")
  acctSessionTime    Int?      @map("acctsessiontime")
  acctInputOctets    BigInt?   @map("acctinputoctets")
  acctOutputOctets   BigInt?   @map("acctoutputoctets")
  calledStationId    String?   @map("calledstationid")
  callingStationId   String?   @map("callingstationid")
  acctTerminateCause String?   @map("acctterminatecause")
  framedProtocol     String?   @map("framedprotocol")
  framedIpAddress    String?   @map("framedipaddress")
  framedIpv6Address  String?   @map("framedipv6address")

  @@index([tenantId, username])
  @@index([acctStartTime])
  @@map("radacct")
}

enum VoucherStatus {
  UNUSED
  ACTIVE
  EXPIRED
  USED
}

model HotspotPackage {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  priceMinor      Int
  currency        String   @default("KES")
  durationMinutes Int
  dataCapMb       Int?
  downloadKbps    Int?
  uploadKbps      Int?
  isPopular       Boolean  @default(false)
  badge           String?
  simultaneousUse Int      @default(1)
  blockTethering  Boolean  @default(false)
  appPolicy       String?  @default("ALL")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotspotVouchers      HotspotVoucher[]
  mpesaStkRequests     MpesaStkRequest[]
  paystackTransactions PaystackTransaction[]

  @@index([tenantId, isActive])
  @@map("hotspot_packages")
}

/// Hotspot voucher — a self-contained, single-use RADIUS user (its own `RadCheck` row) rather
/// than something tied to a CustomerService, since a voucher is bought anonymously at the
/// hotspot, not provisioned against an existing subscription.
model HotspotVoucher {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code             String
  hotspotPackageId String?
  hotspotPackage   HotspotPackage? @relation(fields: [hotspotPackageId], references: [id])
  packageId        String?
  package          Package?        @relation(fields: [packageId], references: [id])
  durationMinutes  Int?
  dataCapMb        Int?
  downloadKbps     Int?
  uploadKbps       Int?
  simultaneousUse  Int?            @default(1)
  appPolicy        String?         @default("ALL")
  status           VoucherStatus   @default(UNUSED)
  activatedAt      DateTime?
  expiresAt        DateTime?
  /// Cumulative usage as of the last RADIUS accounting packet (Interim-Update or Stop) the
  /// embedded/FreeRADIUS server received for this voucher's code — see radius-server.ts's
  /// enforceDataCap, which updates these on the same packets it already parses for cap
  /// enforcement. Null until the voucher's first accounting packet arrives (i.e., before the
  /// router has reported anything yet), not necessarily before the session starts.
  bytesIn          BigInt?
  bytesOut         BigInt?
  usageUpdatedAt   DateTime?
  /// The shop agent holding this voucher to sell, if any.
  agentId          String?
  agent            Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentSale        AgentSale?
  createdByUserId  String?
  createdAt        DateTime        @default(now())

  @@unique([tenantId, code])
  @@map("hotspot_vouchers")
}

/// A customer's phone (by MAC address) and the voucher it last logged in with, per tenant.
/// Recorded by the RADIUS server on every successful voucher login; used to log the same phone
/// straight back in ("login by MAC") while that voucher still has time and data left.
model HotspotDevice {
  id               String   @id @default(uuid())
  tenantId         String
  /// AA:BB:CC:DD:EE:FF, as the router reports it (Calling-Station-Id).
  macAddress       String
  voucherCode      String
  /// The voucher's recorded usage when this phone was last logged back in by MAC. A new session's
  /// counters start at zero, so the voucher's usage is this plus the session's own bytes.
  baselineBytesIn  BigInt   @default(0)
  baselineBytesOut BigInt   @default(0)
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())

  @@unique([tenantId, macAddress])
  @@index([tenantId, voucherCode])
  @@map("hotspot_devices")
}

enum SyncTaskStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// RADIUS-authenticated PPPoE needs no local `/ppp secret` on the router at all — RouterOS's
/// PPP AAA forwards auth to FreeRADIUS directly, and radcheck/radreply (see those models'
/// comments) already govern accept/reject and rate limits. The only router-side action that's
/// ever actually needed is kicking an already-active session after a suspend, since a RADIUS
/// reject only blocks the *next* auth attempt, not a session already established.
/// 802.1Q VLAN purposes. CUSTOM exists so an ISP can label a VLAN for a purpose this list does
/// not name, without a schema change; the human-readable label then lives in Vlan.customTypeLabel.
enum VlanType {
  CUSTOMER_INTERNET
  BUSINESS_INTERNET
  IPTV
  VOIP
  HOTSPOT
  MANAGEMENT
  GUEST
  CUSTOM
}

/// How a VLAN's configuration currently stands ON THE DEVICE, which is deliberately separate
/// from whether an admin has enabled it in this system (Vlan.isEnabled). A VLAN can be enabled
/// here and still NOT_PROVISIONED or FAILED on the router, and the dashboard must be able to
/// show that difference rather than implying a row in this database means live network config.
enum VlanProvisioningStatus {
  NOT_PROVISIONED
  PENDING
  ACTIVE
  FAILED
}

/// How a subscriber actually attaches to the network for a given package.
enum NetworkServiceType {
  PPPOE
  HOTSPOT
  STATIC_IP
  IPTV
}

/// What a provisioning job is trying to make true on the network.
enum ProvisioningOperation {
  /// First-time setup, or re-applying configuration after a package change.
  PROVISION
  /// Subscription lapsed: cut network access WITHOUT deleting anything (spec section 6).
  SUSPEND
  /// Paid again: put the customer back exactly as they were.
  RESTORE
  /// Cancelled for good. Removes device configuration; the customer record stays.
  DEPROVISION
}

/// A job's own lifecycle. Distinct from ServiceProvisioningStatus, which is the SUBSCRIBER's
/// resulting state — one failed SUSPEND job leaves the job FAILED while the subscriber stays
/// ACTIVE, and conflating the two would hide exactly that situation from an operator.
enum ProvisioningJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Where a subscriber actually stands on the network (spec section 5). Never set to ACTIVE
/// except from a device response confirming the configuration was accepted.
enum ServiceProvisioningStatus {
  PENDING
  PROCESSING
  ACTIVE
  FAILED
  SUSPENDED
  DEPROVISIONED
}

enum SyncTaskAction {
  DISCONNECT_USER
}

/// An 802.1Q VLAN an ISP has defined. A row here is a DECLARATION of intent, not proof that the
/// VLAN exists on any device -- provisioningStatus is what tracks the device side, and nothing
/// in this system may report a VLAN as live on a router without an actual device response
/// saying so.
model Vlan {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The 802.1Q tag itself (1-4094). Named vlanTag rather than vlanId so it is never confused
  /// with this row's own primary key, which foreign keys elsewhere point at.
  vlanTag         Int
  name            String
  description     String?
  type            VlanType @default(CUSTOMER_INTERNET)
  /// Only meaningful when type = CUSTOM; the label an admin gave their own VLAN purpose.
  customTypeLabel String?

  /// Nullable: a VLAN can be designed before the router that will carry it is linked. The
  /// compound unique below is what stops two VLANs claiming the same tag on one device.
  routerId String?
  router   Router? @relation(fields: [routerId], references: [id], onDelete: SetNull)

  subnetCidr String?
  gateway    String?
  ipPoolId   String?
  ipPool     IPPool?  @relation(fields: [ipPoolId], references: [id], onDelete: SetNull)
  dnsServers String[] @default([])

  downloadKbps   Int?
  uploadKbps     Int?
  mtu            Int?
  /// The router port the switch trunk is patched into. Detected on the router the first time
  /// the VLAN is set up there (a free ethernet port that isn't WAN, hotspot or LAN), then kept.
  trunkInterface String?

  /// Whether an administrator has this VLAN switched on in the billing system. Distinct from
  /// provisioningStatus, which reflects the device.
  isEnabled             Boolean                @default(true)
  provisioningStatus    VlanProvisioningStatus @default(NOT_PROVISIONED)
  /// The device's own error text from the last failed provisioning attempt, surfaced verbatim to
  /// the admin rather than replaced with a generic message they cannot act on.
  lastProvisioningError String?
  lastProvisionedAt     DateTime?

  /// Fiber/OLT fields. Nullable and unused by any code path today: there is no OLT device model
  /// yet, and inventing one before a real OLT integration exists would be guessing at a vendor's
  /// data shape. They are here so the VLAN record can carry the identifiers a future OLT adapter
  /// will need without a second migration against live data.
  oltDeviceRef    String?
  ponPort         String?
  serviceVlanTag  Int?
  customerVlanTag Int?
  vlanMode        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  packages         Package[]
  provisioningJobs ProvisioningJob[]

  /// The duplicate-VLAN-ID rule the spec calls for, enforced by the database rather than by a
  /// service-layer check alone. Note Postgres treats NULLs as distinct, so this constrains only
  /// VLANs actually assigned to a router; the unassigned case is checked in the service, since
  /// two unrouted VLANs sharing a tag is a warning, not a conflict.
  @@unique([routerId, vlanTag])
  @@index([tenantId, isEnabled])
  @@index([tenantId, type])
  @@map("vlans")
}

/// A unit of network configuration work, queued rather than run inside the request that
/// caused it (spec section 18). A payment must never fail because a router was unreachable,
/// and a router operation must never be retried by retrying a payment.
model ProvisioningJob {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerServiceId String
  customerService   CustomerService @relation(fields: [customerServiceId], references: [id], onDelete: Cascade)

  /// Nullable because a job is still worth recording when the package has no VLAN or the
  /// router has not been linked yet — that is a configuration gap an operator must SEE as a
  /// failed job, not something to silently skip.
  vlanId   String?
  vlan     Vlan?   @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  routerId String?
  router   Router? @relation(fields: [routerId], references: [id], onDelete: SetNull)

  operation ProvisioningOperation
  status    ProvisioningJobStatus @default(PENDING)

  /// Collapses duplicate work: re-running the same operation for the same subscription and
  /// the same intended configuration reuses this row instead of queueing a second job. This
  /// is what makes retries safe (spec section 18) — the unique index is the enforcement.
  idempotencyKey String @unique

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  /// The device's own error text, kept verbatim so an operator sees what the router actually
  /// said rather than a message this system invented (spec section 5).
  lastError String?

  /// The configuration this job intends to apply, snapshotted at queue time. A package edited
  /// afterwards must not silently change what an already-queued job does.
  payload Json
  /// What the device reported on success.
  result  Json?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  logs ProvisioningLog[]

  @@index([tenantId, status])
  @@index([status, createdAt])
  @@map("provisioning_jobs")
}

/// One attempt at one job. Separate from the job so a retry history survives — the job row
/// only carries the LATEST error, and 'it failed three times with the same timeout' is a
/// different diagnosis from 'it failed three times for three different reasons'.
model ProvisioningLog {
  id         String          @id @default(uuid())
  jobId      String
  job        ProvisioningJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attempt    Int
  succeeded  Boolean
  /// Verbatim device response or error. Never rewritten into a friendlier message here; the
  /// UI may summarise, but the record keeps what the device said.
  message    String
  /// Individual steps within the attempt, so a partial failure shows which step broke.
  steps      Json?
  durationMs Int?
  createdAt  DateTime        @default(now())

  @@index([jobId, attempt])
  @@map("provisioning_logs")
}

/// A router-side operation that couldn't be applied synchronously (router unreachable, or the
/// operation is deliberately queued) — retried by a worker job rather than the caller pretending
/// the change already took effect (docs/architecture/06, "Failure mode: router offline").
model NetworkSyncTask {
  id           String         @id @default(uuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routerId     String
  router       Router         @relation(fields: [routerId], references: [id], onDelete: Cascade)
  radiusUserId String?
  radiusUser   RadiusUser?    @relation(fields: [radiusUserId], references: [id])
  action       SyncTaskAction
  status       SyncTaskStatus @default(PENDING)
  attempts     Int            @default(0)
  lastError    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([tenantId, status])
  @@map("network_sync_tasks")
}

/// A branch or town an ISP operates in. Routers, customers and staff can belong to one; reports
/// and lists filter by it. A staff member's branch is their default view, not an access boundary.
model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routers   Router[]
  customers Customer[]
  users     User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

/// One browser or installed dashboard that agreed to receive push alerts for a staff user.
/// The endpoint is unique per device; a gone endpoint (404/410 from the push service) is deleted.
model PushSubscription {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId      String?
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([userId])
  @@index([tenantId])
  @@map("push_subscriptions")
}

enum UpgradeSuggestionStatus {
  PENDING
  APPLIED
  DISMISSED
}

/// A subscriber who keeps running into their package's data cap, and the next plan up that would
/// fit. Found by a worker job; staff apply it (which moves the subscription and re-provisions the
/// router) or dismiss it. Package names and price are copied so the list still reads right after
/// a package is renamed or repriced.
model UpgradeSuggestion {
  id                String                  @id @default(uuid())
  tenantId          String
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerServiceId String
  customerService   CustomerService         @relation(fields: [customerServiceId], references: [id], onDelete: Cascade)
  fromPackageId     String
  fromPackageName   String
  toPackageId       String
  toPackageName     String
  toPriceMinor      Int
  currency          String                  @default("KES")
  usedMb            Int
  capMb             Int
  status            UpgradeSuggestionStatus @default(PENDING)
  smsSentAt         DateTime?
  decidedByUserId   String?
  decidedAt         DateTime?
  createdAt         DateTime                @default(now())

  @@index([tenantId, status])
  @@index([customerServiceId, createdAt])
  @@map("upgrade_suggestions")
}

enum MaintenanceScope {
  ALL
  ROUTERS
  BRANCH
}

enum NetworkMaintenanceStatus {
  SCHEDULED
  CANCELLED
}

/// Planned work on the ISP's own network (not the platform's maintenance mode): customers on the
/// affected routers or branch are texted before it starts and again when it is over.
model NetworkMaintenance {
  id                String                   @id @default(uuid())
  tenantId          String
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title             String
  /// Optional extra line added to the customer SMS.
  message           String?
  startsAt          DateTime
  endsAt            DateTime
  scope             MaintenanceScope         @default(ALL)
  routerIds         String[]                 @default([])
  branchId          String?
  notifyHoursBefore Int                      @default(24)
  status            NetworkMaintenanceStatus @default(SCHEDULED)
  beforeSentAt      DateTime?
  afterSentAt       DateTime?
  /// Customers texted by the last notice that went out.
  recipientCount    Int                      @default(0)
  createdByUserId   String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([tenantId, startsAt])
  @@index([status, startsAt])
  @@map("network_maintenance")
}

enum ReferralRewardType {
  DAYS
  CREDIT
}

/// A reward given to a customer because someone they referred paid for the first time.
model ReferralReward {
  id          String             @id @default(uuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referrerId  String
  referrer    Customer           @relation("ReferralRewardReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId  String             @unique
  referred    Customer           @relation("ReferralRewardReferred", fields: [referredId], references: [id], onDelete: Cascade)
  type        ReferralRewardType
  days        Int?
  amountMinor Int?
  createdAt   DateTime           @default(now())

  @@index([tenantId, createdAt])
  @@map("referral_rewards")
}

enum JobCardType {
  INSTALLATION
  REPAIR
  SURVEY
  RELOCATION
  REMOVAL
}

enum JobCardStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

/// A visit by a field technician: an installation, a repair, a site survey. The technician
/// starts it on site, adds photos and the equipment fitted, and closes it with the customer's
/// signature, all from a phone.
model JobCard {
  id               String              @id @default(uuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number           String
  type             JobCardType
  status           JobCardStatus       @default(OPEN)
  title            String
  notes            String?
  customerId       String?
  customer         Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Where to go, for a job with no customer yet (a survey) or a different site.
  address          String?
  contactPhone     String?
  assignedToUserId String?
  assignedTo       User?               @relation("JobCardAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  scheduledFor     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  /// GPS where the technician started or closed the job.
  latitude         Float?
  longitude        Float?
  equipment        String?
  completionNotes  String?
  signedByName     String?
  createdByUserId  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  attachments      JobCardAttachment[]
  leads            Lead[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([assignedToUserId, status])
  @@map("job_cards")
}

enum JobCardAttachmentKind {
  PHOTO
  SIGNATURE
}

/// A photo or the customer's signature, resized on the phone before upload and kept small.
model JobCardAttachment {
  id               String                @id @default(uuid())
  jobCardId        String
  jobCard          JobCard               @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  kind             JobCardAttachmentKind
  mimeType         String
  sizeBytes        Int
  data             Bytes
  uploadedByUserId String?
  createdAt        DateTime              @default(now())

  @@index([jobCardId])
  @@map("job_card_attachments")
}

enum RouterRolloutStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

enum RouterRolloutTargetStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

/// An over-the-air change pushed to a set of routers: a RouterOS upgrade, a feature, a reboot or
/// a script. The worker applies it one router at a time and records each router's result. With
/// canaryFirst, the first router is done alone and the rest only follow if it succeeded.
model RouterRollout {
  id              String                @id @default(uuid())
  tenantId        String
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  action          String
  /// Action options, e.g. the script for "custom-script".
  params          Json?
  status          RouterRolloutStatus   @default(RUNNING)
  canaryFirst     Boolean               @default(true)
  scheduledFor    DateTime?
  createdByUserId String?
  createdAt       DateTime              @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  targets         RouterRolloutTarget[]

  @@index([tenantId, createdAt])
  @@index([status, scheduledFor])
  @@map("router_rollouts")
}

model RouterRolloutTarget {
  id         String                    @id @default(uuid())
  rolloutId  String
  rollout    RouterRollout             @relation(fields: [rolloutId], references: [id], onDelete: Cascade)
  routerId   String?
  router     Router?                   @relation(fields: [routerId], references: [id], onDelete: SetNull)
  routerName String
  position   Int
  status     RouterRolloutTargetStatus @default(PENDING)
  message    String?
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([rolloutId, position])
  @@map("router_rollout_targets")
}

/// A router's full configuration export, taken before every over-the-air change and nightly.
/// The export carries passwords and keys, so it is encrypted at rest and only owners can
/// download or restore it. Restoring hands the router a one-time link to fetch it from.
model RouterBackup {
  id                    String    @id @default(uuid())
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routerId              String
  router                Router    @relation(fields: [routerId], references: [id], onDelete: Cascade)
  reason                String
  contentEncrypted      String
  sizeBytes             Int
  sha256                String
  routerOsVersion       String?
  createdByUserId       String?
  createdAt             DateTime  @default(now())
  restoreTokenHash      String?   @unique
  restoreTokenExpiresAt DateTime?
  restoredAt            DateTime?

  @@index([routerId, createdAt])
  @@index([tenantId, createdAt])
  @@map("router_backups")
}

/// One reading of a router's health, kept every 5 minutes for 30 days so the dashboard can chart
/// CPU, memory, temperature and availability over time.
model RouterHealthSample {
  id            BigInt   @id @default(autoincrement())
  routerId      String
  router        Router   @relation(fields: [routerId], references: [id], onDelete: Cascade)
  at            DateTime @default(now())
  reachable     Boolean
  cpuPercent    Int?
  memoryPercent Int?
  temperatureC  Float?
  uptimeSeconds Int?

  @@index([routerId, at])
  @@index([at])
  @@map("router_health_samples")
}

/// A pause of a subscription (travel, a closed shop). Billing moves forward by the paused days;
/// an early resume gives the unused days back. `days` is what was actually used.
model ServicePause {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerServiceId String
  customerService   CustomerService @relation(fields: [customerServiceId], references: [id], onDelete: Cascade)
  startsAt          DateTime        @default(now())
  endsAt            DateTime
  days              Int
  requestedBy       String
  resumedAt         DateTime?

  @@index([customerServiceId, startsAt])
  @@map("service_pauses")
}

/// An extra login on a customer's account: a family member or a colleague at a business. They
/// see the account's plans, bills and usage, and can open tickets. Paying is allowed only when
/// canPay is set; pausing, the router password and managing members stay with the account
/// holder. Invited by a link; userId is set once they accept it.
model CustomerMember {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId          String?   @unique
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  phone           String?
  canPay          Boolean   @default(false)
  inviteCode      String?   @unique
  inviteExpiresAt DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([customerId])
  @@map("customer_members")
}

enum AddOnKind {
  /// A faster speed for a while, e.g. 20 Mbps for 24 hours.
  SPEED
  /// Extra data on top of the plan's data cap for a while.
  DATA
}

/// Something a PPPoE customer can buy on top of their plan: a speed boost or extra data, for a
/// set number of hours. Applied as soon as it is paid and removed when the time is up.
model AddOn {
  id            String          @id @default(uuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  kind          AddOnKind
  downloadKbps  Int?
  uploadKbps    Int?
  dataMb        Int?
  durationHours Int
  priceMinor    Int
  currency      String          @default("KES")
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  purchases     AddOnPurchase[]

  @@index([tenantId])
  @@map("addons")
}

enum AddOnPurchaseStatus {
  AWAITING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

/// One purchase of an add-on for one plan. Copies what was bought so later catalogue edits don't
/// change it. Its invoice is paid by M-Pesa; unpaid purchases are cancelled after a short while.
model AddOnPurchase {
  id                String              @id @default(uuid())
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerServiceId String
  customerService   CustomerService     @relation(fields: [customerServiceId], references: [id], onDelete: Cascade)
  addOnId           String?
  addOn             AddOn?              @relation(fields: [addOnId], references: [id], onDelete: SetNull)
  invoiceId         String?             @unique
  invoice           Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  status            AddOnPurchaseStatus @default(AWAITING_PAYMENT)
  name              String
  kind              AddOnKind
  downloadKbps      Int?
  uploadKbps        Int?
  dataMb            Int?
  durationHours     Int
  priceMinor        Int
  currency          String              @default("KES")
  requestedBy       String              @default("customer")
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime            @default(now())

  @@index([customerServiceId, status])
  @@index([status, endsAt])
  @@map("addon_purchases")
}

enum WinBackStatus {
  /// Sent; waiting to see whether the customer pays before it expires.
  SENT
  /// They paid in time and got the discount back as credit.
  REDEEMED
  EXPIRED
  /// The SMS could not be sent.
  FAILED
}

/// A "we miss you" offer texted to a customer at risk of leaving: pay within the window and get
/// a share of that payment back as account credit. Kept so the ISP can see which offers worked.
model WinBackOffer {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason          String
  owedMinor       Int           @default(0)
  discountPercent Int
  status          WinBackStatus @default(SENT)
  message         String
  sentByUserId    String?
  sentAt          DateTime      @default(now())
  expiresAt       DateTime
  redeemedAt      DateTime?
  /// What they paid inside the window, and the credit it earned them.
  paidMinor       Int?
  creditMinor     Int?

  @@index([tenantId, sentAt])
  @@index([status, expiresAt])
  @@index([customerId, sentAt])
  @@map("win_back_offers")
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
}

/// A shop or person who sells the ISP's hotspot vouchers and takes customers' bill payments in
/// cash, for a commission. They sign in to a small app of their own (/agent), see their voucher
/// stock, record sales and payments, and get a monthly statement of what they owe the ISP.
model Agent {
  id                          String            @id @default(uuid())
  tenantId                    String
  tenant                      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                      String?           @unique
  user                        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                        String
  phone                       String
  location                    String?
  /// Commission on each voucher sold, in whole percent of its price.
  voucherCommissionPercent    Int               @default(10)
  /// Commission on each customer bill payment taken, in whole percent.
  collectionCommissionPercent Int               @default(2)
  status                      AgentStatus       @default(ACTIVE)
  inviteCode                  String?           @unique
  inviteExpiresAt             DateTime?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  vouchers                    HotspotVoucher[]
  sales                       AgentSale[]
  remittances                 AgentRemittance[]

  @@index([tenantId])
  @@map("agents")
}

enum AgentSaleKind {
  /// A hotspot voucher from the agent's stock.
  VOUCHER
  /// Cash taken from a customer toward their bill.
  COLLECTION
}

/// Money an agent took: a voucher sold or a customer's bill payment. The agent keeps the
/// commission and owes the ISP the rest.
model AgentSale {
  id              String          @id @default(uuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId         String
  agent           Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  kind            AgentSaleKind
  voucherId       String?         @unique
  voucher         HotspotVoucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  paymentId       String?         @unique
  customerId      String?
  description     String
  amountMinor     Int
  commissionMinor Int
  buyerPhone      String?
  createdAt       DateTime        @default(now())

  @@index([agentId, createdAt])
  @@index([tenantId, createdAt])
  @@map("agent_sales")
}

/// Money an agent handed over to the ISP, recorded by staff.
model AgentRemittance {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId          String
  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  amountMinor      Int
  method           String
  reference        String?
  note             String?
  recordedByUserId String?
  createdAt        DateTime @default(now())

  @@index([agentId, createdAt])
  @@map("agent_remittances")
}

enum CampaignChannel {
  SMS
  WHATSAPP
  BOTH
}

enum CampaignStatus {
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

/// A message sent to a group of customers at once (by SMS, WhatsApp or both), with a record of
/// who got it and who paid in the days after, so the ISP can see whether it brought money in.
model Campaign {
  id              String              @id @default(uuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  /// Text with {firstName}, {accountNumber} and {amountDue} filled in per customer.
  message         String
  channel         CampaignChannel     @default(SMS)
  /// Who gets it: { segment, branchId?, packageId?, inactiveDays? }.
  audience        Json
  status          CampaignStatus      @default(SCHEDULED)
  scheduledAt     DateTime            @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  /// Payments within this many days of the message count as the campaign's result.
  trackDays       Int                 @default(7)
  createdByUserId String?
  createdAt       DateTime            @default(now())
  recipients      CampaignRecipient[]

  @@index([tenantId, createdAt])
  @@index([status, scheduledAt])
  @@map("campaigns")
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
}

model CampaignRecipient {
  id         String                  @id @default(uuid())
  campaignId String
  campaign   Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone      String
  /// The message as this customer got it.
  message    String
  status     CampaignRecipientStatus @default(PENDING)
  error      String?
  sentAt     DateTime?
  /// What they paid within the tracking window after the message, once they have.
  paidMinor  Int?
  paidAt     DateTime?

  @@unique([campaignId, customerId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

enum LeadStatus {
  NEW
  CONTACTED
  /// A site survey or installation job has been booked.
  BOOKED
  /// Now a customer.
  WON
  LOST
}

/// Someone who asked for a connection on the ISP's public signup page. The page checked their
/// location against the ISP's coverage; staff call them, then turn them into a customer with an
/// installation or survey job in one step.
model Lead {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  email       String?
  address     String
  latitude    Float?
  longitude   Float?
  /// Null when no location was shared, so coverage couldn't be checked.
  covered     Boolean?
  distanceKm  Float?
  nearestSite String?
  packageId   String?
  packageName String?
  notes       String?
  status      LeadStatus @default(NEW)
  lostReason  String?
  source      String     @default("web")
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  jobCardId   String?
  jobCard     JobCard?   @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId, status, createdAt])
  @@map("leads")
}

enum MfaMethod {
  TOTP
  SMS
}

enum SupportChatChannel {
  APP
  WHATSAPP
}

enum SupportChatStatus {
  /// The assistant is answering.
  OPEN
  /// Handed to staff as a ticket; new messages go to the ticket.
  HANDED_OVER
  CLOSED
}

/// A customer's conversation with the AI support assistant, in the app or on WhatsApp. When it
/// hands over, the whole conversation goes onto a support ticket for staff.
model SupportChat {
  id         String               @id @default(uuid())
  tenantId   String
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    SupportChatChannel
  status     SupportChatStatus    @default(OPEN)
  ticketId   String?              @unique
  ticket     Ticket?              @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  messages   SupportChatMessage[]

  @@index([customerId, status, updatedAt])
  @@map("support_chats")
}

model SupportChatMessage {
  id        String      @id @default(uuid())
  chatId    String
  chat      SupportChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  /// "user" (the customer), "assistant", or "staff" once handed over.
  role      String
  content   String
  createdAt DateTime    @default(now())

  @@index([chatId, createdAt])
  @@map("support_chat_messages")
}
